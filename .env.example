# Local single-user installation. Change password before first use on a server.
POSTGRES_DB=mdm_db
POSTGRES_USER=mdm
POSTGRES_PASSWORD=local-demo-change-me
SEED_DEMO_DATA=true
BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
# API token from your DaData account. Not a Secret key. Optional: manual entry works without it.
DADATA_API_KEY=
# Select 'dadata' only after choosing the provider and adding its key. 'none' keeps manual entry.
INN_LOOKUP_PROVIDER=none
